{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"types": ["vite/client", "node"],
		"paths": {
			"@/*": ["./src/*"],
			"@generated/*": ["./generated/*"],
			"#runtime": ["./src/server/runtime/node.ts"],
			"#image-pipeline": ["./src/server/media/image-pipeline.node.ts"]
		}
	},
	"include": [
		"src",
		"generated",
		"test",
		"vite.config.ts",
		"vitest.config.ts",
		"prisma.config.ts"
	],
	"exclude": ["node_modules", ".output", ".tanstack", ".edgeone", "app"]
}
