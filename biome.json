{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/.next",
			"!**/.output",
			"!**/.tanstack",
			"!**/.wrangler",
			"!**/dist",
			"!**/build",
			"!**/next-env.d.ts",
			"!generated",
			"!src/routeTree.gen.ts",
			"!**/public/**/*.svg"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
