# 复制为 .env 后填写真实值；不要提交真实凭据。
# 本地开发：运行 `bun run db:dev` 启动 PGlite 开发库，再把输出的 URL 填入下方。

# PostgreSQL 连接串（必填）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Hellō 认证（仅服务端可见）
# 64 位十六进制（32 字节），各环境独立：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HELLO_COOKIE_SECRET=""

# 站长 Hellō sub 白名单。留空时后台一律拒绝访问。
# 通过受控初始化流程读取本人已验证 sub 后填入。
ADMIN_HELLO_SUB=""

# 正式站点域名，用于 canonical / RSS / sitemap；来自部署配置，不在后台编辑
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# S3 兼容对象存储
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# 公开派生图的对外访问前缀（不含尾斜杠）
NEXT_PUBLIC_MEDIA_BASE_URL=""
