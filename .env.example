# 本地开发使用此文件；EdgeOne 控制台「环境变量」需配置同名变量。
# 构建期变量会被写进客户端 bundle，不要放密钥。
# Neon Postgres pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# 构建期变量（会被写进客户端 bundle，不要放密钥）
# VITE_SITE_URL 必须是与线上访问完全一致的 origin，写接口用它做同源校验。
VITE_SITE_URL=http://localhost:3000
VITE_MEDIA_BASE_URL=https://media.example.com

# Neon Managed Better Auth
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-characters
ADMIN_NEON_USER_IDS=neon-user-id-1,neon-user-id-2

# S3 兼容对象存储（同桶时使用 private/ 与 public/ 前缀隔离）
S3_ENDPOINT=https://cos.your-region.myqcloud.com
S3_REGION=your-region
S3_BUCKET=your-private-bucket
S3_PUBLIC_BUCKET=your-public-bucket
# Keep credentials only in the ignored .env file or deployment secrets.
S3_ACCESS_KEY_ID=your-tencent-secret-id
S3_SECRET_ACCESS_KEY=your-tencent-secret-key
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true
