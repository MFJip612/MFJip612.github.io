# 本地开发使用此文件；EdgeOne 控制台「环境变量」需配置同名变量。
# 构建期变量会被写进客户端 bundle，不要放密钥。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres

# 构建期变量（会被写进客户端 bundle，不要放密钥）
# VITE_SITE_URL 必须是与线上访问完全一致的 origin，写接口用它做同源校验。
VITE_SITE_URL=http://localhost:3000
VITE_MEDIA_BASE_URL=https://media.example.com

# 通用 OIDC 登录
AUTH_ISSUER=https://issuer.example.com
AUTH_CLIENT_ID=mfjip612
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/
AUTH_COOKIE_SECRET=replace-with-at-least-32-characters
ADMIN_OIDC_SUBJECTS=subject-id-1,subject-id-2

# S3 兼容对象存储（私有桶 + 公开桶）
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=mfjip612-private
S3_PUBLIC_BUCKET=mfjip612-public
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true
