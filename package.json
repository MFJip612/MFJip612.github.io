{
	"name": "MFJip612.github.io",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": " vite dev",
		"build": "node scripts/clean.mjs && vite build",
		"start": "node server.mjs",
		"deploy": "bun run build && bunx edgeone makers deploy ./.edgeone",
		"preview:edgeone": "node scripts/serve-edgeone.mjs",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:dev": "bun run scripts/dev-db.ts",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate deploy",
		"db:reset": "prisma migrate reset",
		"db:studio": "prisma studio",
		"verify": "bun run typecheck && bun run lint && bun run test && bun run build",
		"postinstall": "prisma generate"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/inter-tight": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@neondatabase/neon-js": "0.9.0-beta",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"@tanstack/react-router": "^1.170.45",
		"@tanstack/react-start": "^1.169.3",
		"aws4fetch": "^1.0.20",
		"dotenv": "^18.0.8",
		"jose": "^6.2.13",
		"oauth4webapi": "^3.8.8",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"sharp": "^0.35.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@edgeone/tanstack-start": "^1.1.0",
		"@edgeone/vite-core": "^1.1.0",
		"@electric-sql/pglite": "^0.5.11",
		"@electric-sql/pglite-socket": "^0.2.14",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^20.19.43",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/ui": "^5.0.5",
		"pg": "^8.23.1",
		"prisma": "7.10.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
