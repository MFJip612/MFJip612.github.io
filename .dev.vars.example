# wrangler dev 使用的本地 secrets（复制为 .dev.vars）
AUTH_COOKIE_SECRET=replace-with-at-least-32-characters
AUTH_ISSUER=https://issuer.example.com
AUTH_CLIENT_ID=mfjip612
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/
ADMIN_OIDC_SUBJECTS=subject-id-1
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=mfjip612-private
S3_PUBLIC_BUCKET=mfjip612-public
