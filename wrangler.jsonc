{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mfjip612",
	"main": "@tanstack/react-start/server-entry",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "REPLACE_WITH_HYPERDRIVE_ID"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}
